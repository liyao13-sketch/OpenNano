# OpenNano 配置示例:复制为 .env 后按需修改(切勿把真实 .env 提交到仓库)
OPENNANO_LLM_API_KEY=sk-xxxx
OPENNANO_LLM_BASE_URL=https://api.deepseek.com/v1
OPENNANO_LLM_MODEL=deepseek-chat
# 数据目录(留空则用工作区默认:个人空间/18_工艺数据资产/03_实验数据)
# OPENNANO_DATA_ROOT=/abs/path/to/03_实验数据
# OPENNANO_CORE_DIR=/abs/path/to/03_实验数据/core
# OPENNANO_DOE_DIR=/abs/path/to/DOE实验
# OPENNANO_KLAYOUT=/usr/local/bin/klayout
